# Database Configuration
# Copy this file to .env and update with your actual credentials

# Local Development Database
DATABASE_URL=postgresql://wab_user:@localhost@localhost:5432/wab_db?client_encoding=utf8

# Production Database (Railway/GCP)
# DATABASE_URL=postgresql://user:password@host:port/database?client_encoding=utf8

# Logging
# Set to True to see all SQL queries (useful for debugging)
SQL_ECHO=False
