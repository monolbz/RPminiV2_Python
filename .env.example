# ============================================================
# Google Maps API Configuration (for Route Optimizer)
# ============================================================
# Get your API key from: https://console.cloud.google.com/google/maps-apis
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Fuel price in EUR per litre used for savings calculations (default: 1.50)
FUEL_PRICE_EUR_PER_L=1.50


# ============================================================
# WhatsApp Business API Configuration (for Webhook)
# ============================================================

# Webhook Verify Token
# Create a random string (e.g., "my_secure_token_12345")
# You'll enter this in Meta Developer Portal when setting up webhook
WHATSAPP_VERIFY_TOKEN=your_verify_token_here

# WhatsApp Access Token
# Get from: Meta Developer Portal > App Dashboard > WhatsApp > API Setup
# This is a long-lived token that starts with "EAAG..."
WHATSAPP_ACCESS_TOKEN=your_access_token_here

# WhatsApp Phone Number ID
# Get from: Meta Developer Portal > WhatsApp > API Setup
# Example: "123456789012345"
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here

# WhatsApp Business Account ID
# Get from: Meta Developer Portal > WhatsApp > API Setup
# Example: "987654321098765"
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id_here

# WhatsApp App Secret (for webhook signature verification)
# Get from: Meta Developer Portal > App Dashboard > Settings > Basic
# Important for security - verifies webhooks are from WhatsApp
WHATSAPP_APP_SECRET=your_app_secret_here


# ============================================================
# WhatsApp Webhook Server Configuration
# ============================================================

# Port for webhook server (default: 5000)
WEBHOOK_PORT=5000

# Host to bind to (default: 0.0.0.0 for all interfaces)
WEBHOOK_HOST=0.0.0.0

# Debug mode (true/false)
DEBUG_MODE=false


# ============================================================
# Session & Template Configuration
# ============================================================

# Session timeout in hours (24-hour conversation window)
SESSION_TIMEOUT_HOURS=24

# Session storage type (json, sqlite, redis)
SESSION_STORE_TYPE=json

# Session storage path
SESSION_STORE_PATH=wab/data/sessions.json

# Default template name (for messages outside 24h window)
WHATSAPP_DEFAULT_TEMPLATE=hello_world

# Templates configuration file path
WHATSAPP_TEMPLATES_CONFIG=wab/config/templates.json


# ============================================================
# Logging Configuration
# ============================================================

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
